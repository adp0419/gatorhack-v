  "narrative": {
    "northStar": "AI experience lab",
    "overview": "AccessBench is an AI experience lab for a website. Warm paper and dark ink give actual browser evidence room to speak; a sharp lime action invites exploration. Editorial serif headings pair with precise sans-serif controls and plain-language explanations.\n\nThe implemented start screen is a launch surface and visual archive of saved reports. The same shared palette reaches the existing dashboard, while its browser-centered structural redesign remains planned. Actual captures and readable uncertainty keep the experience grounded in bounded observation.",
    "keyCharacteristics": [
      "Warm paper, dark ink, and a sharp lime launch action.",
      "Editorial display type with precise, readable interface text.",
      "Actual browser evidence, restrained rules, and flat surfaces.",
      "Visible scope, provenance, and uncertainty."
    ],
    "rules": [
      {
        "name": "The Ink on Lime Rule",
        "body": "Use ink text on lime actions; use deep olive for readable links and focus indicators.",
        "section": "colors"
      },
      {
        "name": "The Evidence First Rule",
        "body": "Use expressive display type to frame the investigation, and readable interface type to explain its observations.",
        "section": "typography"
      },
      {
        "name": "The Flat Paper Rule",
        "body": "Convey grouping with space, surface tone, and rules; keep resting surfaces free of decorative shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use actual saved captures with their scope, version, and status attached.",
      "Do keep body text readable, controls labeled, focus visible, and evidence understandable in text.",
      "Do distinguish the implemented start screen from the planned browser-centered workspace."
    ],
    "donts": [
      "Don't use lime for small text or as the sole focus indicator.",
      "Don't manufacture screenshots, progress, passing outcomes, or evidence.",
      "Don't turn a screenshot-led start-screen composition into a mandatory layout for every product surface."
    ]
  }
