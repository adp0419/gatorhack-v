{
  "name": "accessbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests/browser/*.test.js",
    "spike": "node --env-file-if-exists=.env scripts/spike.js",
    "audit": "node --env-file-if-exists=.env scripts/audit.js",
    "check": "node scripts/check.js",
    "format": "prettier --write src public scripts tests",
    "format:check": "prettier --check src public scripts tests",
    "rehearse": "node --env-file-if-exists=.env scripts/rehearse.js"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "express": "5.3.0",
    "ipaddr.js": "2.5.0",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
