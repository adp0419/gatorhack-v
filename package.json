{
  "name": "accessbench",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded five-category accessibility benchmark with a live Twinly-driven walkthrough.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "fixtures": "node fixtures/server.js",
    "fixture:broken": "node fixtures/set-variant.js broken",
    "fixture:fixed": "node fixtures/set-variant.js fixed",
    "spike": "node --env-file-if-exists=.env scripts/spike.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "express": "^4.22.3",
    "playwright": "^1.64.1"
  }
}
